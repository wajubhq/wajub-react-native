{
  "name": "@wajub/react-native",
  "version": "1.5.0",
  "description": "Native Wajub checkout SDK for React Native — Mobile Money, cards, wallets, light and dark, no WebView.",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "lib",
    "src",
    "!src/__fixtures__",
    "!src/__tests__",
    "!src/test"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "jest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "pusher-js": "^8.4.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "@react-native-community/netinfo": ">=11.0.0",
    "@stripe/stripe-react-native": ">=0.38.0",
    "react": ">=18",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "@stripe/stripe-react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.76.9",
    "@stripe/stripe-react-native": "^0.41.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.76.9",
    "react-test-renderer": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wajubhq/wajub-react-native"
  },
  "publishConfig": {
    "access": "public"
  }
}
